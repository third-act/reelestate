---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoForm from '../components/DemoForm.astro';
import { getCollection } from 'astro:content';
export const prerender = false;

const niche = Astro.url.searchParams.get('nisch') ?? 'okänd';
const niches = await getCollection('niches');
const match = niches.find(n => n.data.slug === niche);
const label = match?.data.cardLabel;
---
<BaseLayout title="Boka demo – Reel Estate" description="Boka en 30-minuters demo och se hur din egen app skulle se ut." niche={match?.data.slug} accentColor={match?.data.accentColor} accentInk={match?.data.accentInk}>
  <section class="mx-auto max-w-6xl px-5 py-14 md:grid md:grid-cols-[1fr_1.2fr] md:gap-16">
    <div class="max-w-md">
      <h1 class="text-4xl md:text-5xl">Boka demo</h1>
      <p class="mt-5 text-lg text-muted">Berätta lite om er, så förbereder vi en demo. Vi hör av oss inom en arbetsdag.</p>
      <ul class="mt-8 space-y-2 text-muted">
        <li>30 minuter över video</li>
        <li>Inga förpliktelser</li>
      </ul>
    </div>
    <div class="mt-10 md:mt-0">
      <DemoForm niche={niche} nicheLabel={label} />
    </div>
  </section>
</BaseLayout>
