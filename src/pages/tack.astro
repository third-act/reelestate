---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand } from '../config/brand';
export const prerender = false;
---
<BaseLayout title="Tack – Reel Estate" description="Tack för din förfrågan.">
  <section class="mx-auto max-w-6xl px-5 py-14">
    <h1 class="text-4xl md:text-5xl">Tack, vi hör av oss.</h1>
    <p class="mt-4 max-w-md text-lg text-muted">Vi mejlar dig inom en arbetsdag. Har du bråttom kan du höra av dig direkt.</p>
    <p class="mt-6"><a class="btn btn-primary" href={`mailto:${brand.contactEmail}`}>Mejla {brand.contactEmail}</a></p>
  </section>
</BaseLayout>
