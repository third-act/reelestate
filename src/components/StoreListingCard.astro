---
/** App Store-listning – kompakt kort bredvid hero-mockup. */
interface Props { color: string }
const { color } = Astro.props;
const icon = 56;
const r = icon * 0.2237;
---

<div class="store-listing w-[280px] select-none rounded-2xl border border-line bg-surface/95 p-4 shadow-[0_14px_44px_-18px_rgba(20,33,61,.2)] backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <div
      class="relative grid shrink-0 place-items-center px-1.5 text-center font-heading text-[10px] font-semibold leading-[1.1] text-white"
      style={`width:${icon}px;height:${icon}px;border-radius:${r}px;background:linear-gradient(145deg, color-mix(in srgb, ${color} 88%, white), ${color} 55%, color-mix(in srgb, ${color} 75%, black))`}
      aria-hidden="true"
    >
      <span class="relative z-[1]">Din<br />logotyp</span>
      <div
        class="pointer-events-none absolute inset-0 opacity-35"
        style={`border-radius:${r}px;background:linear-gradient(155deg, rgba(255,255,255,.45) 0%, transparent 42%)`}
        aria-hidden="true"
      ></div>
    </div>

    <p class="text-[13px] leading-[1.4] text-muted">
      Din egen app med skräddarsydd branding<br />
      i <span class="font-medium text-ink">Appstore</span> och <span class="whitespace-nowrap font-medium text-ink">Google Play</span>
    </p>
  </div>
</div>
