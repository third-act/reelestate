---
import { brand } from '../config/brand';
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
const niches = (await getCollection('niches')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <Logo />
      <p class="mt-3 max-w-xs text-sm text-muted">{brand.description}</p>
    </div>
    <div>
      <p class="mb-3 font-semibold">Branscher</p>
      <ul class="space-y-2 text-sm text-muted">
        {niches.map(n => <li><a class="hover:text-ink" href={`/${n.data.slug}`}>{n.data.cardLabel}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="mb-3 font-semibold">Kontakt</p>
      <a class="text-sm text-muted hover:text-ink" href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
      <p class="mt-6 text-xs text-muted">© {year} {brand.legalName}</p>
    </div>
  </div>
</footer>
