---
import { brand } from '../config/brand';
---

<div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2">
  <p class="text-sm text-muted">{brand.customerLine}</p>
  <div class="flex items-center gap-3">
    {brand.customerLogos.map(logo => (
      <img
        src={logo.src}
        alt={logo.name}
        width={logo.width}
        height={logo.height}
        class="customer-logo h-[14px] w-auto max-w-[72px] object-contain object-left opacity-60"
        loading="lazy"
        decoding="async"
      />
    ))}
  </div>
</div>

<style>
  .customer-logo {
    filter: grayscale(1);
  }
</style>
