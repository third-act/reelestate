---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<section class="bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-16 md:grid md:grid-cols-[1fr_2fr] md:gap-10">
    <h2 class="text-3xl md:text-4xl">Vanliga frågor</h2>
    <div class="mt-8 divide-y divide-line md:mt-0">
      {items.map(item => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium">
            {item.q}
            <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-2 max-w-prose text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
