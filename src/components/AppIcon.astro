---
/** iOS-liknande squircle-ikon från nischens exampleBrand */
interface Props { name: string; initials: string; color: string; size?: number; label?: boolean }
const { name, initials, color, size = 72, label = true } = Astro.props;
const r = size * 0.2237;
---
<div class="inline-flex flex-col items-center gap-2">
  <div
    class="relative grid place-items-center font-heading font-bold text-white shadow-[0_8px_24px_-8px_rgba(20,33,61,.45)]"
    style={`width:${size}px;height:${size}px;border-radius:${r}px;background:linear-gradient(145deg, color-mix(in srgb, ${color} 88%, white), ${color} 55%, color-mix(in srgb, ${color} 75%, black));font-size:${size * 0.34}px;letter-spacing:-.03em`}
    aria-hidden="true"
  >
    <span class="relative z-[1]">{initials}</span>
    <div
      class="pointer-events-none absolute inset-0 opacity-35"
      style={`border-radius:${r}px;background:linear-gradient(155deg, rgba(255,255,255,.45) 0%, transparent 42%)`}
      aria-hidden="true"
    ></div>
  </div>
  {label && <span class="text-xs font-medium text-ink/80">{name}</span>}
</div>
