---
/** App Store-liknande ikon genererad från nischens exampleBrand */
interface Props { name: string; initials: string; color: string; size?: number; label?: boolean }
const { name, initials, color, size = 72, label = true } = Astro.props;
---
<div class="inline-flex flex-col items-center gap-2">
  <div
    class="grid place-items-center font-heading font-bold text-white shadow-[0_8px_24px_-8px_rgba(20,33,61,.45)]"
    style={`width:${size}px;height:${size}px;border-radius:${size * 0.225}px;background:${color};font-size:${size * 0.36}px;letter-spacing:-.02em`}
    aria-hidden="true"
  >{initials}</div>
  {label && <span class="text-xs font-medium text-ink/80">{name}</span>}
</div>
