---
import { brand } from '../config/brand';
interface Props { niche?: string; heading?: string; text?: string }
const { niche, heading = 'Se hur Reel Estate-appen fungerar', text = 'Boka 30 minuter. Vi visar Reel Estate-appen och hur den passar er verksamhet.' } = Astro.props;
const href = niche ? `/demo?nisch=${niche}` : '/demo';
---
<section class="mx-auto max-w-6xl px-5 py-16">
  <div class="rounded-3xl bg-primary px-8 py-12 text-white md:px-14 md:py-16">
    <h2 class="max-w-xl text-3xl text-white md:text-4xl">{heading}</h2>
    <p class="mt-4 max-w-lg text-white/75">{text}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={href} class="btn btn-accent">Boka demo</a>
      <a href={`mailto:${brand.contactEmail}`} class="text-sm text-white/75 hover:text-white">eller mejla {brand.contactEmail}</a>
    </div>
  </div>
</section>
