---
import AppMockup from './AppMockup.astro';
import CustomerLogos from './CustomerLogos.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { niche: CollectionEntry<'niches'>['data'] }
const { niche } = Astro.props;
---
<section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-14 md:grid-cols-[1.05fr_1fr] md:gap-14 lg:gap-20 md:pt-20">
  <div class="relative z-10 max-w-xl lg:max-w-md xl:max-w-xl">
    <p class="mb-4 text-sm font-medium text-muted">{niche.cardLabel}</p>
    <h1 class="niche-title text-[2.35rem] leading-[1.08] md:text-[2.75rem] md:leading-[1.06] lg:text-6xl lg:leading-[1.04]">{niche.title}</h1>
    <p class="mt-6 max-w-md text-lg text-muted">{niche.subtitle}</p>
    <p class="mt-4 max-w-md text-ink/80">{niche.painLine}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`/demo?nisch=${niche.slug}`} class="btn btn-primary">Boka demo</a>
      <a href="#appen" class="btn btn-ghost">Se hur det funkar</a>
    </div>
    <CustomerLogos />
  </div>
  <div class="hero-visual flex justify-center md:justify-end">
    <div class="hero-mockup-wrap">
      <AppMockup niche={niche} view={niche.heroScreen} />
    </div>
  </div>
</section>

<style>
  .hero-mockup-wrap {
    transform: perspective(1100px) rotateY(-10deg) rotateX(5deg);
    transform-origin: center bottom;
    filter: drop-shadow(0 24px 48px rgba(20, 33, 61, 0.28));
  }
  .hero-mockup-wrap :global(.phone) {
    --w: 318px;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-mockup-wrap {
      transform: none;
      filter: drop-shadow(0 16px 32px rgba(20, 33, 61, 0.2));
    }
  }
  @media (max-width: 640px) {
    .hero-mockup-wrap :global(.phone) {
      --w: 268px;
    }
  }
  .niche-title {
    max-width: 14ch;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .niche-title { max-width: 16ch; }
  }
  @media (min-width: 1024px) {
    .niche-title { max-width: 13ch; }
  }
  @media (min-width: 1280px) {
    .niche-title { max-width: 15ch; }
  }
</style>
