---
interface Props { steps: { day: string; title: string; description: string }[] }
const { steps } = Astro.props;
---
<section class="mx-auto max-w-6xl px-5 py-16">
  <h2 class="text-3xl md:text-4xl">Så går det till</h2>
  <ol class="mt-10 grid gap-8 md:grid-cols-3">
    {steps.map((s, i) => (
      <li class="relative pl-14">
        <span class="absolute left-0 top-0 grid h-10 w-10 place-items-center rounded-full bg-primary font-heading text-sm font-bold text-white">{i + 1}</span>
        <p class="text-sm font-medium" style="color:var(--niche-accent-ink);opacity:.7">{s.day}</p>
        <h3 class="text-xl">{s.title}</h3>
        <p class="mt-1.5 text-muted">{s.description}</p>
      </li>
    ))}
  </ol>
</section>
