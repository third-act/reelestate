---
import AppMockup from './AppMockup.astro';
import BrandPreview from './BrandPreview.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { niche: CollectionEntry<'niches'>['data'] }
const { niche } = Astro.props;
const allViews = ['home', 'booking', 'access', 'feed'] as const;
const views = allViews.filter(v => v !== niche.heroScreen);
const brandCaption = 'Din egen app, skräddarsydd för Appstore och Google Play.';
---
<section class="bg-surface overflow-visible">
  <div class="mx-auto max-w-6xl overflow-visible px-5 py-16">
    <h2 class="max-w-lg text-3xl md:text-4xl">Så ser din app ut</h2>
    <p class="mt-3 max-w-lg text-muted">Fyra vyer. Ditt namn, dina färger, ditt innehåll. Ingen annan verksamhet i samma app.</p>
    <div class="showcase-grid mt-10 flex gap-6 overflow-x-auto pb-4 md:grid md:grid-cols-4">
      <figure class="showcase-figure showcase-figure--brand flex shrink-0 flex-col items-center gap-7 md:gap-8">
        <BrandPreview defaultColor={niche.exampleBrand.color} size="sm" hideCaption />
        <figcaption class="max-w-[220px] text-center text-sm text-muted">{brandCaption}</figcaption>
      </figure>
      {views.map(v => (
        <figure class="flex shrink-0 flex-col items-center gap-7 md:gap-8">
          <AppMockup niche={niche} view={v} size="sm" />
          <figcaption class="max-w-[220px] text-center text-sm text-muted">{niche.screenCaptions[v]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase-grid {
    overflow: visible;
  }

  .showcase-figure {
    overflow: visible;
  }

  /* Låt testpanelen sväva utanför utan att rubba mockup-rutnätet */
  .showcase-figure--brand {
    position: relative;
    z-index: 1;
  }
</style>
